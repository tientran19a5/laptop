{
  "github.copilot.editor.enableAutoCompletions": false,
  "editor.lineHeight": 2.5,
  "editor.fontFamily": "ComicShannsMono Nerd Font, Cascadia Code",
  "editor.fontLigatures": "'calt', 'liga', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09'",
  "terminal.integrated.lineHeight": 1.5,
  "terminal.integrated.cursorStyleInactive": "none",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.fontFamily": "ComicShannsMono Nerd Font, Cascadia Code",
  "editor.formatOnSave": true,
  "editor.wordWrap": "on",
  "editor.wrapOnEscapedLineFeeds": true,
  "editor.detectIndentation": false,
  "editor.selectionHighlight": false,
  "editor.letterSpacing": 0.5,
  "editor.fontSize": 13,
  "terminal.integrated.letterSpacing": 0.5,
  "workbench.activityBar.location": "default",
  "workbench.editor.showTabs": "multiple",
  "workbench.statusBar.visible": true,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.indent": 8,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "explorer.decorations.badges": false,
  "git.decorations.enabled": false,
  "vscode_custom_css.imports": [
    "file:///C:/Softwares/custom-vscode/custom.css"
  ],
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": false,
  "chat.tools.terminal.outputLocation": "chat",
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.suggest.upArrowNavigatesHistory": false,
  "git.openRepositoryInParentFolders": "always",
  "editor.cursorWidth": 3,
  "color-highlight.markerType": "underline",
  "editor.tabSize": 2,
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.cursorWidth": 3,
  "workbench.editor.empty.hint": "hidden",
  "terminal.integrated.initialHint": false,
  "chat.viewSessions.orientation": "stacked",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "extensions.ignoreRecommendations": true,
  "files.autoSave": "afterDelay",
  "github.copilot.nextEditSuggestions.fixes": false,
  "github.copilot.nextEditSuggestions.allowWhitespaceOnlyChanges": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.nextEditSuggestions.extendedRange": false,
  "chat.tips.enabled": false,
  "git.autofetch": true,
  "terminal.integrated.suggest.quickSuggestions": {
    "commands": "on",
    "arguments": "on",
    "unknown": "off"
  },
  "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
  "vsicons.dontShowNewVersionMessage": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "workbench.iconTheme": "material-icon-theme",
  "github.copilot.chat.codeGeneration.useInstructionFiles": false,
  "chat.disableAIFeatures": true,
  "redhat.telemetry.enabled": true,
  "svelte.enable-ts-plugin": true,
  "notebook.insertFinalNewline": true,
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "security.workspace.trust.untrustedFiles": "open",
  "json.schemaDownload.trustedDomains": {
    "https://aka.ms": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://spec.openapis.org/": true,
    "https://www.schemastore.org/": true
  },
  "editor.unicodeHighlight.nonBasicASCII": false
}
